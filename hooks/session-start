#!/usr/bin/env bash
# Ninja SessionStart hook.
# Concatenates hooks/context.d/*.md (sorted) and emits the payload as
# additionalContext via the hookSpecificOutput format that Codex and
# Claude Code both consume.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONTEXT_DIR="${SCRIPT_DIR}/context.d"

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

[[ -d "${CONTEXT_DIR}" ]] || exit 0

context=""
while IFS= read -r module; do
  [[ "$(basename "$module")" == README.md ]] && continue
  module_content="$(cat "$module" 2>/dev/null || true)"
  [[ -z "${module_content}" ]] && continue
  if [[ -n "${context}" ]]; then
    context+=$'\n\n'
  fi
  context+="${module_content}"
done < <(find "${CONTEXT_DIR}" -maxdepth 1 -type f -name '*.md' | sort)

[[ -z "${context}" ]] && exit 0

payload="<NINJA_SESSION_GUIDANCE>
${context}
</NINJA_SESSION_GUIDANCE>"

payload_escaped="$(escape_for_json "${payload}")"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "${payload_escaped}"

exit 0
